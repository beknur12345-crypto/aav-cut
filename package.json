{
  "name": "aav-cut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy && tsx prisma/seed.ts || exit 1; fi; next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bench": "tsx scripts/bench.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.9.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ag-grid-community": "32.3.3",
    "ag-grid-react": "32.3.3",
    "bcryptjs": "2.4.3",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "nodemailer": "10.2.1",
    "pg": "8.19.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "read-excel-file": "5.8.8",
    "server-only": "^0.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "10.4.21",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.6",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
