# Postgres connection (docker compose maps the db to localhost:5433)
DATABASE_URL="postgresql://aavcut:aavcut@localhost:5433/aavcut?schema=public"
# Public base URL, used in password-reset emails
APP_URL="http://localhost:3100"
# Optional SMTP for outgoing mail, e.g. smtp://user:pass@smtp.example.com:587
# Without it, emails are written to the server log (development only).
SMTP_URL=""
MAIL_FROM="AAV Cut <no-reply@example.com>"
# Mail via Resend (added automatically by the Vercel Marketplace integration); takes priority over SMTP_URL
RESEND_API_KEY=""
# Error tracking (Sentry); leave empty to disable
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
